 "captionContent": {
  "content": {
   "blocks": [
    {
     "key": "vws6r",
     "type": "unstyled",
     "text": "Our Code of Conduct is how we work with each other, with customers and with partners. It is short on purpose. Read it once now, and come back to it whenever a decision feels unclear.",
     "depth": 0,
     "inlineStyleRanges": [],
     "entityRanges": [],
     "data": {}
    },
    {
     "key": "ed2ie",
     "type": "header-two",
     "text": "What we expect from everyone",
     "depth": 0,
     "inlineStyleRanges": [],
     "entityRanges": [],
     "data": {}
    },
    {
     "key": "c85tr",
     "type": "unordered-list-item",
     "text": "Treat colleagues, customers and partners with respect, in every channel and every language.",
     "depth": 0,
     "inlineStyleRanges": [],
     "entityRanges": [],
     "data": {}
    },
    {
     "key": "zz91y",
     "type": "unordered-list-item",
     "text": "Be honest about what you know, what you do not know and what went wrong.",
     "depth": 0,
     "inlineStyleRanges": [],
     "entityRanges": [],
     "data": {}
    },
    {
     "key": "m5hc6",
     "type": "unordered-list-item",
     "text": "Protect customer data as if it were your own.",
     "depth": 0,
     "inlineStyleRanges": [],
     "entityRanges": [],
     "data": {}
    },
    {
     "key": "9iq7s",
     "type": "unordered-list-item",
     "text": "Speak up when something does not feel right. Raising a concern in good faith is always safe.",
     "depth": 0,
     "inlineStyleRanges": [],
     "entityRanges": [],
     "data": {}
    },
    {
     "key": "qifds",
     "type": "header-two",
     "text": "Where to raise a concern",
     "depth": 0,
     "inlineStyleRanges": [],
     "entityRanges": [],
     "data": {}
    },
    {
     "key": "fob4d",
     "type": "unstyled",
     "text": "Talk to your manager first when you can. If that does not feel right, contact your People partner or use the confidential Speak Up line listed on the People Hub. Every report is reviewed by someone outside your reporting line.",
     "depth": 0,
     "inlineStyleRanges": [],
     "entityRanges": [],
     "data": {}
    },
    {
     "key": "0u1nv",
     "type": "header-two",
     "text": "Acknowledge this page",
     "depth": 0,
     "inlineStyleRanges": [],
     "entityRanges": [],
     "data": {}
    },
    {
     "key": "lzmpx",
     "type": "unstyled",
     "text": "Use the acknowledge button at the end of this page to confirm you have read the Code. It ticks this step off in your onboarding journey.",
     "depth": 0,
     "inlineStyleRanges": [],
     "entityRanges": [],
     "data": {}
    }
   ],
   "entityMap": {},
   "lastUpdatedAt": "2026-10-05T09:28:17.82Z"
  },
  "contentType": "DraftJS"
 },
