{
  "name": "action-required",
  "version": "2.0.0",
  "description": "Lists what the viewer must read and acknowledge (pending items, or the pages of one space), with due dates, read time and tasks",
  "private": true,
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production && npm run package",
    "package": "node scripts/package.js",
    "test": "node --no-warnings test/unit.mjs",
    "serve": "PORT=4871 node test/serve.js"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.5",
    "@babel/plugin-bugfix-firefox-class-in-computed-class-key": "^7.28.5",
    "@babel/preset-env": "^7.22.5",
    "@babel/preset-react": "^7.22.5",
    "archiver": "^6.0.1",
    "babel-loader": "^9.1.2",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.5.3",
    "mini-css-extract-plugin": "^2.7.6",
    "style-loader": "^3.3.3",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
